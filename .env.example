# === AI 引擎 (Kimi API, Anthropic 兼容协议) ===
KIMI_API_KEY=your-api-key
KIMI_BASE_URL=https://api.kimi.com/coding/
KIMI_MODEL=kimi-k2.7

# === 海外新生活平台 API ===
WOOHELPS_API_URL=https://www.woohelps.com
WOOHELPS_LOGIN_SESSION=your-login-session

# === 数据库 (Supabase PostgreSQL) ===
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# === 浏览器（留空=本地启动 Chromium） ===
BROWSER_WS_ENDPOINT=

# === 管理界面 ===
ADMIN_PASSWORD=

# === 日志 ===
LOG_LEVEL=INFO

# 数据库 schema（共用 Supabase 项目时填独立 schema 名；独立项目留空/删除此行即可，默认 public）
DB_SCHEMA=public
